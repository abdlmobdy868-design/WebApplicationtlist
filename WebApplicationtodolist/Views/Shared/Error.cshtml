@model WebApplicationtodolist.Models.ErrorViewModel
@{
    ViewData["Title"] = "حصل خطأ";
}

<div class="container text-center my-5">
    <div class="card shadow-sm p-4 rounded-4">
        <div class="card-body">
            <div style="font-size:96px;">😅</div>
            <h1 class="mt-3">حصل حاجة غلط بس احنا شغالين عليها</h1>
            <p class="text-muted">نعتذر عن الإزعاج — حاول الرجوع للصفحة الرئيسية أو تواصل معنا إذا استمرت المشكلة.</p>

            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-3">العودة للرئيسية</a>
        </div>
    </div>
</div>
