@model CourseMaterial
@{
    ViewData["Title"] = "اضافة مادة";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4 rounded-4" style="max-width:720px;width:100%">
        <h4 class="mb-3">اضافة مادة جديدة</h4>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="form-floating mb-3">
                <input asp-for="Title" class="form-control" placeholder="عنوان المادة" />
                <label asp-for="Title">العنوان</label>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="form-control" placeholder="وصف المادة" style="height:120px"></textarea>
                <label asp-for="Description">الوصف</label>
            </div>
            <div class="mb-3">
                <label class="form-label">رفع ملف (اختياري)</label>
                <input type="file" name="file" class="form-control" />
            </div>
            <div class="d-flex justify-content-end">
                <button class="btn btn-gradient">حفظ</button>
            </div>
        </form>
    </div>
</div>
