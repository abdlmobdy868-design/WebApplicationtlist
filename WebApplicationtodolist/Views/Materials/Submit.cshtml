@model WebApplicationtodolist.Models.Assignment
@{
    ViewData["Title"] = "Submit Assignment";
}
<div class="container" dir="rtl">
    <h3 class="text-end" style="color:#4F46E5">ارسال المهمة: @Model.Title</h3>
    <div class="card mt-3">
        <div class="card-body">
            <form asp-action="Submit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">اختر ملف</label>
                    <input type="file" name="upload" class="form-control" />
                </div>
                <button class="btn" style="background-color:#4F46E5;color:white">ارسال</button>
            </form>
        </div>
    </div>
</div>
