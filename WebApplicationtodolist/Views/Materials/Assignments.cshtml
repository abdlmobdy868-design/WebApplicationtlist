@model List<WebApplicationtodolist.Models.Assignment>
@{
    ViewData["Title"] = "Assignments";
}
<div class="container" dir="rtl">
    <h3 class="text-end" style="color:#4F46E5">المهام</h3>
    <div class="row">
        @foreach(var a in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@a.Title</h5>
                        <p class="card-text">@a.Description</p>
                        <p class="text-muted">@a.CreatedAt.ToLocalTime()</p>
                        <a asp-action="Submit" asp-route-id="@a.Id" class="btn" style="background-color:#4F46E5;color:white">ارسال الواجب</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
